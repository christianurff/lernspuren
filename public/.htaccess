# Dokumentenraum: App-Dateien immer beim Server gegenprüfen (Updates kommen sofort an),
# Vorlagen-Bilder und Icons dürfen lange gecacht werden.
Options -Indexes
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|jpg|jpeg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Universal Links: Apple verlangt application/json für die AASA-Datei
<Files "apple-app-site-association">
  ForceType application/json
  <IfModule mod_headers.c>
    Header set Content-Type "application/json"
    Header set Cache-Control "no-cache"
  </IfModule>
</Files>
